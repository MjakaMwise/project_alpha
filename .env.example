# Casini project: otbigsimwwlnuwkigehv
# Copy the exact PostgreSQL URL from the project's Connect dialog.
# For IPv4 networks, use its session pooler (port 5432).
# Keep credentials on the Rust server. The driver enforces verified TLS.
# Add sslrootcert=/absolute/path/to/project-ca.crt to the URL if needed.
CUSTOMIZE_DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@db.otbigsimwwlnuwkigehv.supabase.co:5432/postgres?sslmode=verify-full
# Bootstrap the first admin only when no admin exists.
CUSTOMIZE_ADMIN_EMAIL=admin@customize.shop
CUSTOMIZE_ADMIN_PASSWORD=
